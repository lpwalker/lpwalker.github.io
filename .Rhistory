n <- 30
# create a space for the estimates
estimates_b <- tibble(b0 = rep(NA, R),
b1 = rep(NA, R))
# simulate the data
for (r in 1:R) {
# X ~ Uniform(a = 0, b = 10)
dat.q4 <- tibble(x = runif(n, min = 0, max = 10)) |>
mutate(y = 2             # Intercept
+ 1.5 * x         # Xi predictor
# Shifted exponentially distributed errors
+ r2exp(n, rate = 1, shift = -1))
# model
mod.q4 <- lm(y ~ x, data = dat.q4)
# store estimates
estimates_b$b0[r] <- coef(mod.q4)[1] # b0
estimates_b$b1[r] <- coef(mod.q4)[2] # b1
}
# plot the estimates
p.b0.b <- ggplot(estimates_b, aes(x = b0)) +
geom_histogram(aes(y = after_stat(density)), bins = 30,
fill = "lightgrey", color = "black") +
geom_density(color = "goldenrod", linewidth = 1) +
geom_vline(xintercept = 2, color = "skyblue3",
linetype = "dashed", linewidth = 1) +       # true beta_0
labs(x = expression(hat(beta)[0]), y = "Density") +
theme_bw()
p.b1.b <- ggplot(estimates_b, aes(x = b1)) +
geom_histogram(aes(y = after_stat(density)), bins = 30,
fill = "lightgrey", color = "black") +
geom_density(color = "goldenrod", linewidth = 1) +
geom_vline(xintercept = 1.5, color = "skyblue3",
linetype = "dashed", linewidth = 1) +       # true beta_1
labs(x = expression(hat(beta)[1]), y = "Density") +
theme_bw()
#| fig-width: 10
#| fig-height: 5
p.b0.b | p.b1.b
?rcauchy
