# data from table above
dat.q2 <- tibble(
temp     = c(25, -25, -75, -125, -175),          # x (degrees C)
strength = c(81.93, 76.63, 63.23, 32.13, 12.83)  # y (MPa)
)
x <- dat.q2$temp
y <- dat.q2$strength
# estimate of b1 (slope) using calculus
b1.hat <- sum((x - mean(x)) * (y - mean(y))) / sum((x - mean(x))^2)
# estimate of b0 (intercept) using calculus
b0.hat <- mean(y) - b1.hat * mean(x)
c(b0.hat = b0.hat, b1.hat = b1.hat)
