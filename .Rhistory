?optim
# Negative log-likelihood where theta = c(beta0, beta1, sigma)
neg.llike <- function(theta, x, y) {
b0 <-    theta[1]
b1 <-    theta[2]
sigma <- theta[3]
mu <- beta0 + beta1 * x                # E(Y | x)
-sum(dnorm(y, mean = mu, sd = sigma, log = TRUE))
}
mle <- optim(par = c(mean(y), 0, sd(y)),   # starting values
fn  = neg.llike,
x = x, y = y,
control = list(maxit = 10000, reltol = 1e-12))
# Negative log-likelihood where theta = c(beta0, beta1, sigma)
neg.llike <- function(theta, x, y) {
b0 <-    theta[1]
b1 <-    theta[2]
sigma <- theta[3]
mu <- b0 + b1 * x                # E(Y | x)
-sum(dnorm(y, mean = mu, sd = sigma, log = TRUE))
}
mle <- optim(par = c(mean(y), 0, sd(y)),   # starting values
fn  = neg.llike,
x = x, y = y,
control = list(maxit = 10000, reltol = 1e-12))
mle$par           # b0.hat, b1.hat, sigma.hat
mle$convergence   # 0 means it converged
# Negative log-likelihood where theta = c(beta0, beta1, sigma)
neg.llike <- function(theta, x, y) {
b0 <-    theta[1]
b1 <-    theta[2]
sigma <- theta[3]
mu <- b0 + b1 * x                # E(Y | x)
-sum(dnorm(y, mean = mu, sd = sigma, log = TRUE))
}
mle <- optim(par = c(mean(y), 0, sd(y)),   # starting values
fn  = neg.llike,
x = x, y = y,
control = list(maxit = 10000, reltol = 1e-12))
mle$par           # b0.hat, b1.hat, sigma.hat
mle
