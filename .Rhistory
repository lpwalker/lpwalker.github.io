beta1 <- 0.25
p <- 3 # beta0, beta1, beta2
vif.vals <- c(1.0, 1.5, 2.0, 5.0, 10)
tibble(VIF = vif.vals) |>
mutate(rho = sqrt(1 - 1/VIF),
f2  = beta1^2/VIF,
n   = map_dbl(f2, ~ ceiling(pwr.f2.test(u = 1,
f2 = .x,
sig.level = 0.05,
power = 0.80)$v + p))) |>
kable(digits = 4)
p <- 2 # beta0, beta1
f2.naive <- 0.50^2/1^2
(n.simple <- ceiling(pwr.f2.test(u = 1,
f2 = f2.naive,
sig.level = 0.05,
power = 0.80)$v + p))
p <- 4 # beta0, beta1, beta2, beta3
(n.naive <- ceiling(pwr.f2.test(u = 1,
f2 = f2.naive,
sig.level = 0.05,
power = 0.80)$v + p))
p <- 2 # beta0, beta1
f2.no.int <- 0.50^2/1^2
(n.simple <- ceiling(pwr.f2.test(u = 1,
f2 = f2.no.int,
sig.level = 0.05,
power = 0.80)$v + p))
p <- 4 # beta0, beta1, beta2, beta3
(n.no.int <- ceiling(pwr.f2.test(u = 1,
f2 = f2.no.int,
sig.level = 0.05,
power = 0.80)$v + p))
set.seed(1313)
R <- 1000
int.p <- rep(NA, R)
for(i in 1:R){
x1 <- rbinom(n = n.naive, size = 1, prob = 0.50)
x2 <- rbinom(n = n.naive, size = 1, prob = 0.50)
y  <- 0 + 0*x1 + 0*x2 + 0.50*(x1*x2) + rnorm(n = n.naive, mean = 0, sd = 1)
int.p[i] <- summary(lm(y ~ x1*x2))$coefficients["x1:x2", "Pr(>|t|)"]
}
mean(int.p < 0.05) # empirical power
set.seed(1313)
R <- 1000
int.p <- rep(NA, R)
for(i in 1:R){
x1 <- rbinom(n = n.no.int, size = 1, prob = 0.50)
x2 <- rbinom(n = n.no.int, size = 1, prob = 0.50)
y  <- 0 + 0*x1 + 0*x2 + 0.50*(x1*x2) + rnorm(n = n.no.int, mean = 0, sd = 1)
int.p[i] <- summary(lm(y ~ x1*x2))$coefficients["x1:x2", "Pr(>|t|)"]
}
mean(int.p < 0.05) # power
(var.prod <- 0.25*(1 - 0.25))
dat.combos <- tibble(X1 = c(0, 1, 0, 1),
X2 = c(0, 0, 1, 1)) |>
mutate(X1X2 = X1*X2)
dat.combos
(R2.prod <- summary(lm(X1X2 ~ X1 + X2, data = dat.combos))$r.squared)
# create dataset
dat.combos <- tibble(X1 = c(0, 1, 0, 1),
X2 = c(0, 0, 1, 1)) |>
mutate(X1X2 = X1*X2)
# report R2
(R2.prod <- summary(lm(X1X2 ~ X1 + X2, data = dat.combos))$r.squared)
# power analysis: not ignoring interacion
p <- 4 # beta0, beta1, beta2, beta3
beta3 <- 0.50
(f2.int <- beta3^2*var.prod*(1 - R2.prod)/1^2)
(n.int <- ceiling(pwr.f2.test(u = 1,
f2 = f2.int,
sig.level = 0.05,
power = 0.80)$v + p))
